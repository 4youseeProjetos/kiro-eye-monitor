<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kiro-eye-monitor"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="CorOk" Color="#FF0096FF" />
        <SolidColorBrush x:Key="CorAtencao" Color="#FFDCDCAA" />
        <SolidColorBrush x:Key="CorCritica" Color="#FFF48771" />
        <SolidColorBrush x:Key="FundoCartao" Color="#F51B1B1F" />
        <SolidColorBrush x:Key="FundoElevado" Color="#FF24242A" />
        <SolidColorBrush x:Key="Borda" Color="#FF34343C" />
        <SolidColorBrush x:Key="TextoPrincipal" Color="#FFF5F7FA" />
        <SolidColorBrush x:Key="TextoSecundario" Color="#FFB4B8C2" />
        <SolidColorBrush x:Key="TextoDiscreto" Color="#FF7D828E" />

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF303038" />
                                <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF3B3B45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF303038" />
                                <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A0096FF" />
                                <Setter Property="Foreground" Value="{StaticResource CorOk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CorOk}" />
            <Setter Property="Background" Value="#1F0096FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#350096FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#500096FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF2B2B32" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#220096FF" />
                                <Setter Property="Foreground" Value="{StaticResource CorOk}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloDeSecao" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB9DCFA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Border x:Name="WidgetFrame"
                Background="{StaticResource FundoCartao}"
                BorderBrush="{StaticResource Borda}"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <Grid x:Name="StandardPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10,10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="DragHandle"
                            Grid.Column="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Padding="2,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource CorOk}" />
                                <TextBlock Text="KIRO EYE"
                                           Foreground="{StaticResource TextoPrincipal}"
                                           FontSize="12"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock x:Name="StatusText"
                                       Foreground="{StaticResource TextoDiscreto}"
                                       FontSize="9"
                                       Margin="15,2,0,0"
                                       Text="Carregando..."
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="MinimizeButton"
                            Grid.Column="1"
                            Content="Menor"
                            ToolTip="Mostrar apenas percentual e creditos"
                            Style="{StaticResource HeaderButtonStyle}" />
                    <ToggleButton x:Name="PinButton"
                                  Grid.Column="2"
                                  Content="Fixar"
                                  ToolTip="Manter sobre outras janelas"
                                  Style="{StaticResource HeaderToggleStyle}" />
                    <ToggleButton x:Name="ExpandButton"
                                  Grid.Column="3"
                                  Content="Detalhes"
                                  ToolTip="Mostrar projetos e analise"
                                  Style="{StaticResource HeaderToggleStyle}" />
                    <Button x:Name="CloseButton"
                            Grid.Column="4"
                            Content="&#x00D7;"
                            ToolTip="Ocultar na bandeja"
                            FontSize="16"
                            Style="{StaticResource HeaderButtonStyle}" />
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource Borda}" />

                <Grid Grid.Row="2" Margin="16,13,16,12">
                    <Border x:Name="ErrorPanel"
                            Visibility="Collapsed"
                            Background="#20FF6B6B"
                            BorderBrush="{StaticResource CorCritica}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Falha ao ler o consumo"
                                       Foreground="{StaticResource CorCritica}"
                                       FontSize="13"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="ErrorText"
                                       Foreground="{StaticResource TextoPrincipal}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Text="--" />
                            <TextBlock x:Name="ErrorHintText"
                                       Foreground="{StaticResource TextoSecundario}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"
                                       Text="--" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="AccountPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UsagePercentText"
                                       Grid.Column="0"
                                       Foreground="{StaticResource TextoPrincipal}"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Text="--%" />
                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,2"
                                        VerticalAlignment="Bottom">
                                <TextBlock x:Name="PlanText"
                                           Foreground="#FFB9DCFA"
                                           FontSize="10"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Text="Carregando..." />
                                <TextBlock x:Name="HeadlineText"
                                           Foreground="{StaticResource TextoPrincipal}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           Text="--" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="UsageBar"
                                     Height="8"
                                     Margin="0,11,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Background="#FF303039"
                                     BorderThickness="0" />
                        <TextBlock x:Name="PercentText"
                                   Foreground="{StaticResource TextoSecundario}"
                                   FontSize="10"
                                   Margin="0,6,0,0"
                                   Text="--" />

                        <Border Background="{StaticResource FundoElevado}"
                                CornerRadius="9"
                                Padding="10,8"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="BurnText"
                                           Foreground="{StaticResource CorAtencao}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Text="--" />
                                <TextBlock x:Name="ProjectionText"
                                           Foreground="{StaticResource TextoSecundario}"
                                           FontSize="10"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="--" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border x:Name="ExpandedDetails"
                        Grid.Row="3"
                        Visibility="Collapsed"
                        BorderBrush="{StaticResource Borda}"
                        BorderThickness="0,1,0,0"
                        Padding="12,10,12,8">
                    <TabControl x:Name="MainTabs"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                        <TabItem x:Name="SummaryTab" Header="Projetos" IsSelected="True">
                            <ScrollViewer x:Name="ProjectScrollViewer"
                                          MaxHeight="300"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="4,10,4,4">
                                <StackPanel>
                                    <TextBlock x:Name="CliTotalText"
                                               Foreground="{StaticResource TextoPrincipal}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Text="--" />
                                    <ItemsControl x:Name="ProjectList" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="68" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Nome}"
                                                               Foreground="{StaticResource TextoSecundario}"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Caminho}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Creditos}"
                                                               Foreground="{StaticResource CorOk}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="UnattributedText"
                                               Foreground="#FFD88ACF"
                                               FontSize="10"
                                               Margin="0,9,0,0"
                                               TextWrapping="Wrap"
                                               Text="" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="AnalysisTab" Header="Analise">
                            <ScrollViewer x:Name="AnalysisScrollViewer"
                                          MaxHeight="300"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="4,10,4,4">
                                <StackPanel>
                                    <TextBlock Text="Creditos por dia" Style="{StaticResource TituloDeSecao}" />
                                    <TextBlock x:Name="DaySummaryText"
                                               Foreground="{StaticResource TextoSecundario}"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="--" />
                                    <ItemsControl x:Name="DayList" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3" ToolTip="{Binding Dica}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="62" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Dia}"
                                                               Foreground="{StaticResource TextoSecundario}"
                                                               FontSize="10" />
                                                    <Border Grid.Column="1"
                                                            Width="{Binding Largura}"
                                                            Height="7"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource CorOk}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Creditos}"
                                                               Foreground="{StaticResource TextoPrincipal}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="{StaticResource Borda}" Margin="0,13" />

                                    <TextBlock Text="Creditos por chat" Style="{StaticResource TituloDeSecao}" />
                                    <TextBlock x:Name="ChatSummaryText"
                                               Foreground="{StaticResource TextoSecundario}"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="--" />
                                    <ItemsControl x:Name="ChatList" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8" ToolTip="{Binding Dica}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="64" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Titulo}"
                                                                   Foreground="{StaticResource TextoPrincipal}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Creditos}"
                                                                   Foreground="{StaticResource CorOk}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detalhe}"
                                                               Foreground="{StaticResource TextoDiscreto}"
                                                               FontSize="9"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <Grid Grid.Row="4" Margin="16,8,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Foreground="{StaticResource TextoDiscreto}"
                               FontSize="9"
                               VerticalAlignment="Center"
                               Text="Atualização automática a cada 5 min" />
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Content="Atualizar"
                            Style="{StaticResource ActionButtonStyle}" />
                </Grid>
                </Grid>

                <Grid x:Name="MinimalPanel"
                      Visibility="Collapsed"
                      Margin="12,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MinimalDragHandle"
                                Grid.Column="0"
                                Background="Transparent"
                                Cursor="SizeAll"
                                Padding="2,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7"
                                         Margin="0,0,7,0"
                                         Fill="{StaticResource CorOk}" />
                                <TextBlock x:Name="MinimalPercentText"
                                           Foreground="{StaticResource TextoPrincipal}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Text="--%" />
                                <TextBlock x:Name="MinimalCreditsText"
                                           Foreground="{StaticResource TextoSecundario}"
                                           FontSize="9"
                                           Margin="10,1,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="Carregando..." />
                            </StackPanel>
                        </Border>
                        <Button x:Name="MinimalExpandButton"
                                Grid.Column="1"
                                Content="Expandir"
                                ToolTip="Mostrar o cartao normal"
                                Style="{StaticResource HeaderButtonStyle}" />
                        <Button x:Name="MinimalCloseButton"
                                Grid.Column="2"
                                Content="&#x00D7;"
                                ToolTip="Ocultar na bandeja"
                                FontSize="16"
                                Style="{StaticResource HeaderButtonStyle}" />
                    </Grid>
                    <ProgressBar x:Name="MinimalUsageBar"
                                 Grid.Row="1"
                                 Height="3"
                                 Margin="2,6,2,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Background="#FF303039"
                                 BorderThickness="0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
